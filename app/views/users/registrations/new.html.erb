<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru&family=Potta+One&display=swap" rel="stylesheet">

<body class="login-body">
  <main class="main-content-signup">
    <h2>新規登録</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="field">
        <h3>ニックネーム</h3>
        <%= f.text_field :name, autofocus: true, placeholder: "名前を入力" %>
      </div>

      <div class="field">
        <h3>メールアドレス</h3>
        <%= f.email_field :email, autocomplete: "email", placeholder: "メールアドレスを入力" %>
      </div>

      <div class="field">
        <h3>パスワード
          <% if @minimum_password_length %>
            <small>（<%= @minimum_password_length %>文字以上）</small>
          <% end %>
        </h3>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "パスワードを入力" %>
      </div>

      <div class="field">
        <h3>パスワード確認</h3>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "パスワードを再入力" %>
      </div>

      <div class="actions">
        <%= f.submit "登録する", class: "Login" %>
      </div>
    <% end %>

    <%= render "users/shared/links" %>
  </main>
</body>
