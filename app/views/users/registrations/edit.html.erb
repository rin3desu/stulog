<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru&family=Potta+One&display=swap" rel="stylesheet">

<body class="login-body">
  <main class="main-content-signup">
    <h2>プロフィール編集</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="field">
        <h3>メールアドレス</h3>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <h3>ニックネーム</h3>
        <%= f.text_field :name, autocomplete: "name" %>
      </div>

      <div class="field">
        <h3>プロフィール画像</h3>
        <%= f.file_field :image %>
      </div>

      <div class="field">
        <h3>プロフィール</h3>
        <%= f.text_area :profile %>
      </div>

      <div class="field">
        <h3>新しいパスワード <small>（変更しない場合は空欄）</small></h3>
        <%= f.password_field :password, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <h3>新しいパスワード確認</h3>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <h3>現在のパスワード <small>（変更を保存するために必要）</small></h3>
        <%= f.password_field :current_password, autocomplete: "current-password" %>
      </div>

      <div class="actions">
        <%= f.submit "保存する", class: "Login" %>
      </div>
    <% end %>

    <div class="actions">
      <%= button_to "アカウントを削除する", registration_path(resource_name),
          data: { confirm: "本当に削除しますか？この操作は取り消せません。" },
          method: :delete, class: "delete-account-btn" %>
    </div>

    <%= link_to "戻る", :back, class: "devise-link" %>
  </main>
</body>
