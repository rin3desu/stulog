<div class="user-show-container">
  <h1><%= @user.name %></h1>

  <% if @user.image.attached? %>
    <%= image_tag @user.image, size: '250x200', class: "profile-image" %>
  <% end %>

  <p class="profile-text"><%= @user.profile %></p>

  <div class="follow-stats">
    <span>フォロー中: <%= @user.following.count %></span>
    <span>フォロワー: <%= @user.followers.count %></span>
  </div>

  <% if user_signed_in? && current_user != @user %>
    <div class="follow-action">
      <% if current_user.following?(@user) %>
        <%= button_to "フォロー解除", user_follow_path(@user), method: :delete, class: "unfollow-btn" %>
      <% else %>
        <%= button_to "フォローする", user_follow_path(@user), method: :post, class: "follow-btn" %>
      <% end %>
    </div>
  <% end %>

  <% if current_user&.id == @user.id %>
    <%= link_to "プロフィール編集", edit_user_registration_path, class: "edit-btn" %>
  <% end %>

  <h2>投稿一覧</h2>
  <% @user.tweets.each do |t| %>
    <div class="tweet-summary">
      <p><strong>模試名:</strong> <%= t.test %> | <strong>科目:</strong> <%= t.subject %></p>
      <p><%= t.comment %></p>
      <% if t.image.attached? %>
        <%= image_tag t.image, size: '250x200' %>
      <% end %>
    </div>
  <% end %>

  <%= link_to "Tweet一覧に戻る", tweets_path, class: "back-link" %>
</div>
