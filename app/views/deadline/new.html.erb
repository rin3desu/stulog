<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru&family=Potta+One&display=swap" rel="stylesheet">

<div class="deadline-new-wrapper">
  <header class="head">
    <h1 class="logo">StudyDiary</h1>
  </header>

  <main class="deadline-main">
    <div class="deadline-form-card">
      <h2 class="deadline-title">試験日の設定</h2>
      <p class="deadline-desc">試験名と試験日を入力すると、マイページに残り日数が表示されます。</p>

      <%= form_with url: deadline_index_path, method: :post, local: true do |f| %>
        <div class="deadline-field">
          <label for="deadline_content">試験名</label>
          <%= text_field_tag "deadline[content]",
              @deadline&.content,
              placeholder: "例：2025年度共通テスト",
              class: "deadline-input",
              id: "deadline_content" %>
        </div>

        <div class="deadline-field">
          <label for="deadline_exam_date">試験日</label>
          <%= date_field_tag "deadline[exam_date]",
              @deadline&.due_date&.to_date,
              class: "deadline-input",
              id: "deadline_exam_date" %>
        </div>

        <%= submit_tag "設定を保存する", class: "deadline-submit-btn" %>
      <% end %>
    </div>
  </main>

  <footer>
    <small>© 2024 SaitoRinsei @ kinchan</small>
  </footer>
</div>
