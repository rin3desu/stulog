<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru&family=Potta+One&display=swap" rel="stylesheet">

<div class="hello-wrapper">
  <div class="hello-notebook">

    <%# ── 左ページ: ダーク × 猫 ── %>
    <div class="hello-left-page">
      <i class="fa-solid fa-cat hello-cat-icon"></i>
    </div>

    <div class="hello-spine"></div>

    <%# ── 右ページ: 罫線 × ボタン ── %>
    <div class="hello-right-page">
      <div class="hello-logo-area">
        <span class="hello-title">StudyDiary</span>
      </div>
      <div class="hello-nav-links">
        <%= link_to "ログイン", mypage_index_path, class: "hello-oval" %>
        <%= link_to "新規登録", new_user_registration_path, class: "hello-oval" %>
      </div>
    </div>

  </div>
</div>
