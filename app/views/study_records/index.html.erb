<header class="head">
  <h1 class="logo">StudyDiary</h1>
  <% if user_signed_in? %>
    <%= link_to mypage_index_path(current_user.id) do %>
      <% if @user.image.attached? %>
        <%= image_tag @user.image, class: "user_image" %>
      <% else %>
        <%= image_tag "pro1.png", class: "user_image" %>
      <% end %>
    <% end %>
  <% end %>
</header>

<main class="main-container-Studyindex">
  <section class="record-section">
    <h2>勉強記録</h2>
    <ul class="record-list">
      <% @study_records.each do |record| %>
        <li>
          <div class="datarow">
            <div class="heading">科目名</div>
            <div class="Studyrecord"><%= record.subject %></div>
          </div>
          <div class="datarow">
            <div class="heading">単元名</div>
            <div class="Studyrecord"><%= record.section %></div>
          </div>
          <div class="datarow">
            <div class="heading">勉強時間</div>
            <div class="Studyrecord"><%= record.time %>min</div>
          </div>
          <div class="datarow">
            <div class="heading">感想</div>
            <div class="Studyrecord"><%= record.comment %></div>
          </div>
          <div class="datarow">
            <div class="headingTime">投稿者</div>
            <div class="Studyrecord"><%= record.user&.name || "不明" %></div>
          </div>
          <div class="datarow">
            <div class="headingTime">投稿日時</div>
            <div class="Studyrecord"><%= record.updated_at.strftime("%Y/%m/%d") %></div>
          </div>

          <div class="record-actions">
            <% if user_signed_in? %>
              <% if @liked_record_ids.include?(record.id) %>
                <%= button_to study_record_study_record_like_path(record, record),
                    method: :delete, class: "like-btn liked" do %>
                  <i class="fa-solid fa-heart"></i> <%= record.study_record_likes.size %>
                <% end %>
              <% else %>
                <%= button_to study_record_study_record_likes_path(record),
                    method: :post, class: "like-btn" do %>
                  <i class="fa-regular fa-heart"></i> <%= record.study_record_likes.size %>
                <% end %>
              <% end %>
            <% else %>
              <span class="like-count"><i class="fa-solid fa-heart"></i> <%= record.study_record_likes.size %></span>
            <% end %>
            <%= link_to "コメント (#{record.study_record_comments.size})", study_record_path(record), class: "comment-link" %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <aside class="log-section">
    <h2>勉強時間の集計</h2>
    <div class="log-area">
      <p class="TotalTime">総勉強時間: <%= @total_study_time %> min</p>
      <ul class="log-list">
        <% @total_time_by_subject.each do |subject, total_time| %>
          <li>
            <div class="datarow">
              <div class="heading"><%= subject %></div>
              <div class="Studyrecord"><%= total_time %> min</div>
            </div>
          </li>
        <% end %>
      </ul>
      <div id="chart-data" data-chart='<%= @chart_data %>' style="display: none;"></div>
      <canvas id="studyChart" width="400" height="200"></canvas>
      <%= javascript_pack_tag 'study_chart' %>
      <p class="Record"><%= link_to "新しい記録を追加", new_study_record_path, class: "newrecord" %></p>
    </div>
  </aside>
</main>
<footer>
  <small>© 2024 SaitoRinsei @ kinchan</small>
</footer>
