<h1>勉強記録</h1>
<%= link_to "新しい記録を追加", new_study_record_path %>
<table>
  <thead>
    <tr>
      <th>科目名</th>
      <th>単元名</th>
      <th>勉強時間 (時間)</th>
      <th>感想</th>
    </tr>
  </thead>
  <tbody>
    <% @study_records.each do |record| %>
      <tr>
        <td><%= record.subject %></td>
        <td><%= record.section %></td>
        <td><%= record.time %></td>
        <td><%= record.comment %></td>
        <td>
          <%= link_to "編集", edit_study_record_path(record) %> |
          <%= button_to "削除", study_record_path(record), method: :delete %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>勉強時間の集計</h2>
<ul>
  <% @total_time_by_subject.each do |subject, total_time| %>
    <li><%= subject %>: <%= total_time %> 分</li>
  <% end %>
</ul>

<p>総勉強時間: <%= @total_study_time %> 分</p>

<div id="chart-data" data-chart='<%= @chart_data %>' style="display: none;"></div>
<canvas id="studyChart" width="400" height="200"></canvas>

<%= javascript_pack_tag 'study_chart' %>



<%= link_to "トップページへ" , mypage_index_path%>
