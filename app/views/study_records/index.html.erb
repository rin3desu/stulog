<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyDiary</title>
    <link rel="stylesheet" href="study_records.scss">
</head>
<body>
  <header class="head">
    <h1 class="logo">StudyDiary</h1>
      <% if user_signed_in? %>
        <%= link_to  mypage_index_path(current_user.id) do%>
          <% if @user.image.attached? %>
            <%= image_tag  @user.image,class: "user_image" %>
          <% else %>
            <%= image_tag "pro1.png", class: "user_image" %>
          <% end %>
        <% end %>
      <% end %>
  </header>
  
  <main class="main-container-Studyindex">
    <section class = "record-section">
      <h2>勉強記録     </h2>
      <ul class="record-list">
      <% @study_records.each do |record| %>
        <li>
          <p class="list">
            <div class="datarow">
              <div class="heading">科目名</div>
              <div class="Studyrecord"><%= record.subject %></div>
            </div>
          </p>
          <p class="list">
            <div class="datarow">
              <div class="heading">単元名</div>
              <div class="Studyrecord"><%= record.section %></div>
            </div>
          </p>
          <p class="list">
            <div class="datarow">
              <div class="heading">勉強時間</div>
              <div class="Studyrecord"><%= record.time %>min</div>
            </div>
          </p>
          <p class="list">
            <div class="datarow">
              <div class="heading">感想</div>
              <div class="Studyrecord"><%= record.comment %></div>
            </div>
          </p>
          <p class="list">
            <div class="datarow">
              <div class="headingTime">投稿日時</div>
              <div class="Studyrecord"><%= record.updated_at %></div>
            </div>
          </p>
          <%# <%= link_to "編集", edit_study_record_path(record) %>  
          <%# <%= button_to "削除", study_record_path(record), method: :delete %> 
        </li>
      <% end %>
    </section>

    <aside class="log-section">
      <h2>勉強時間の集計</h2>
      <div class="log-area">
          <p class="TotalTime">総勉強時間: <%= @total_study_time %> min</p>
        <ul class="log-list">
          <% @total_time_by_subject.each do |subject, total_time| %>
          <li>
            <p class="list">
              <div class="datarow">
                <div class="heading"><%= subject %></div> 
                <div class="Studyrecord"><%= total_time %> min</div>
              </div>
            </p>
          </li>
        <% end %>
        </ul>
        <div id="chart-data" data-chart='<%= @chart_data %>' style="display: none;"></div>
        <canvas id="studyChart" width="400" height="200"></canvas>

        <%= javascript_pack_tag 'study_chart' %>
        <p class="Record"><%= link_to "新しい記録を追加", new_study_record_path, class: "newrecord" %></p>
      </div>
    </aside>
  </main>
  <footer>
     <small>© 2024 SaitoRinsei @ kinchan</small>
  </footer>
</body>
