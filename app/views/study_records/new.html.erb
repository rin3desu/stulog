<h1>勉強記録</h1>
<h3>今回の記録</h3>
<%= form_for @study_record do |f| %>

  <%# データ型がstringで自由記述の入力フォーム %>
  <div class="field">
    <%= f.label :"科目" %>
   <%= f.select :subject, 
    [["英語", "英語"], 
    ["数学", "数学"], 
    ["化学", "化学"],
    ["物理", "物理"],
    ["生物","生物"],
    ["国語","国語"],
    ["日本史","世界史"],
    ["世界史","世界史"],
    ["地理","地理"],
    ["現代社会","現代社会"]], include_blank: "選択して下さい" %>
  </div>

  <%# データ型がstringで選択式の入力フォーム %>
  <div class="field">
    <%= f.label :"単元" %>
    <%= f.text_field :section, :size => 30 %>
  </div>

  <%# データ型がIntegerの勉強時間の入力フォーム %>
  <div class="field">
    <%= f.label :"勉強時間" %>
    <%= f.number_field :time, step: 0.1 %>
  </div>

  <%# データ型がtextで自由記述の入力フォーム %>
  <div class="field">
    <%= f.label :"感想"  %>
    <%= f.text_area :comment, :size => "30x6" %>
  </div>

  <%= f.submit "記録する" %>
<% end %>

<%= link_to "一覧に戻る", study_records_path %>
