<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyHack</title>
    <link rel="stylesheet" href="study_records.scss">
</head>
<body>
  <header class="header">
    <h1 class="logo">StudyHack</h1>
      <% if user_signed_in? %>
        <%= link_to  mypage_index_path(current_user.id) do%>
          <% if @user.image.attached? %>
            <%= image_tag  @user.image,class: "user_image" %>
          <% else %>
            <%= image_tag "C:/GeekWeb/product/studysite/app/assets/images/pro1.png" ,class:"user_image"%>
          <% end %>
        <% end %>
      <% end %>
  </header>

  
  <main class="main-container-newStudy">        
      <h1>勉強記録の編集</h1>
      <%= form_for @study_record do |f| %>

        <%# データ型がstringで自由記述の入力フォーム %>
        <div class="field">
            <div class="heading"><%= f.label :"科目" %></div>
            <div class="Studyrecord">
              <%= f.select :subject, 
              [["英語", "英語"], 
              ["数学", "数学"], 
              ["化学", "化学"],
              ["物理", "物理"],
              ["生物","生物"],
              ["国語","国語"],
              ["日本史","世界史"],
              ["世界史","世界史"],
              ["地理","地理"],
              ["現代社会","現代社会"]], 
              include_blank: "選択して下さい" %>
          </div>
        </div>

        <%# データ型がstringで選択式の入力フォーム %>
        <div class="field">
            <div class="heading"><%= f.label :"単元" %></div>
            <div class="Studyrecord"><%= f.text_field :section, :size => 15 %></div>
        </div>

        <%# データ型がIntegerの勉強時間の入力フォーム %>
        <div class="field">
            <div class="heading"><%= f.label :"勉強時間" %></div>
            <div class="Studyrecord"><%= f.number_field :time, step: 0.1 %></div>
        </div>

        <%# データ型がtextで自由記述の入力フォーム %>
        <div class="field">
            <div class="heading"><%= f.label :"感想"  %></div>
            <div class="Studyrecord"><%= f.text_area :comment, :size => "30x6" %></div>
        </div>

        <p class="Record"><%= f.submit "編集する",class: "newrecord" %></p>
      <% end %>

      <%= link_to "一覧に戻る", study_records_path %>
    </section>
  </main>
</body>



