<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kiwi+Maru&family=Potta+One&display=swap" rel="stylesheet">

<div class="mypage-wrapper">
  
  <%= render 'shared/header' %>

  <main class="main-content-mypage">
    <%# 残り日数の表示 %>
    <%# <%= button_to 'ログアウト', destroy_user_session_path, method: :delete %> 
    
    <div class="deadline-container">
      <% if @deadline.present? %>
        <p class="deadline_string"><%= @deadline.content.present? ? @deadline.content : "試験" %>まで</p>
        <p class="deadline_string2"><%= @remaining_days %>日</p>
      <% else %>
        <p class="deadline_string">試験日が設定されていません</p>
      <% end %>
      <%= link_to "試験日を設定する", new_deadline_path, class: "set-deadline-btn" %>
    </div>
  
    <div class="options">
      <div class="content">
        <%= link_to image_tag("studylecord.png"), study_records_path, class:"content" %>
      </div>
      <div class="content">
        <%= link_to image_tag("testlog.png"), tweets_path %>
      </div>
      <div class="content">
        <%= link_to image_tag("motivate.png"), youtubes_path %>
      </div>
    </div>
  </main>

  <footer>
     <small>© 2024 SaitoRinsei @ kinchan</small>
  </footer>

</div>