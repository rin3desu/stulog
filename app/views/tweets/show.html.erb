<header class="head">
  <h1 class="logo">StudyDiary</h1>
  <% if user_signed_in? %>
    <%= link_to mypage_index_path(current_user.id) do %>
      <% if current_user.image.attached? %>
        <%= image_tag current_user.image, class: "user_image" %>
      <% else %>
        <%= image_tag "pro1.png", class: "user_image" %>
      <% end %>
    <% end %>
  <% end %>
</header>

<main class="main-container-show">
  <div class="show-card">
    <div class="tweets-container">
      <div class="user-icon">
        <% if @tweet.user.image.attached? %>
          <%= image_tag @tweet.user.image, size: '50x50', alt: 'user_icon' %>
        <% else %>
          <%= image_tag "pro1.png", class: "user-image" %>
        <% end %>
      </div>
      <div class="tweet-details">
        <p><strong>投稿者</strong> <%= @tweet.user.name %></p>
        <p><strong>模試の名前</strong> <%= @tweet.test %></p>
        <p><strong>科目名</strong> <%= @tweet.subject %></p>
        <p><strong>単元名</strong> <%= @tweet.section %></p>
        <p><strong>投稿日時</strong> <%= @tweet.created_at.strftime("%Y/%m/%d %H:%M") %></p>
      </div>
    </div>

    <% if @tweet.image.attached? %>
      <div class="tweet-image">
        <%= image_tag @tweet.image, size: '400x300', alt: '模試画像' %>
      </div>
    <% end %>

    <p class="comment-head">反省ポイント</p>
    <p class="comment"><%= @tweet.comment %></p>

    <div class="tweet-actions">
      <% if user_signed_in? %>
        <% if current_user.already_liked?(@tweet) %>
          <%= button_to tweet_like_path(@tweet, @tweet), method: :delete, class: "like-btn liked" do %>
            <i class="fa-solid fa-heart"></i> <%= @tweet.likes.count %> いいね
          <% end %>
        <% else %>
          <%= button_to tweet_likes_path(@tweet), method: :post, class: "like-btn" do %>
            <i class="fa-regular fa-heart"></i> <%= @tweet.likes.count %> いいね
          <% end %>
        <% end %>
      <% else %>
        <span class="like-count"><i class="fa-solid fa-heart"></i> <%= @tweet.likes.count %> いいね</span>
      <% end %>
    </div>

    <% if user_signed_in? && @tweet.user == current_user %>
      <div class="owner-actions">
        <%= link_to "編集する", edit_tweet_path(@tweet), class: "edit-btn" %>
        <%= button_to "削除する", tweet_path(@tweet), method: :delete,
            data: { confirm: "本当に削除しますか？" }, class: "delete-btn" %>
      </div>
    <% end %>
  </div>

  <div class="comments-section">
    <h3>コメント (<%= @comments.size %>件)</h3>

    <% @comments.each do |comment| %>
      <div class="comment-item">
        <div class="comment-header">
          <% if comment.user.image.attached? %>
            <%= image_tag comment.user.image, class: "comment-avatar" %>
          <% else %>
            <%= image_tag "pro1.png", class: "comment-avatar" %>
          <% end %>
          <strong><%= comment.user.name %></strong>
          <small><%= comment.created_at.strftime("%Y/%m/%d %H:%M") %></small>
          <% if user_signed_in? && comment.user == current_user %>
            <%= button_to "削除", tweet_comment_path(@tweet, comment), method: :delete,
                class: "delete-comment-btn" %>
          <% end %>
        </div>
        <p class="comment-body"><%= comment.content %></p>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <div class="comment-form">
        <h4>コメントを投稿する</h4>
        <%= form_for [@tweet, @new_comment] do |f| %>
          <%= f.text_area :content, placeholder: "コメントを入力してください...", class: "comment-textarea" %>
          <%= f.submit "投稿する", class: "comment-submit-btn" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= link_to "一覧に戻る", tweets_path, class: "back-link" %>
</main>
