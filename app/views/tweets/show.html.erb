<h1>GeekTwitter</h1>
<h2>Tweet詳細</h2>

<div class="tweet">
  <h3>模試の種類</h3>
  <p><%= @tweet.test %></p>
  <h3>科目名</h3>
  <p><%= @tweet.subject %></p>
  <h3>単元名</h3>
  <p><%= @tweet.section %></p>
  <h3>感想・次回までにやること</h3>
  <p><%= @tweet.comment %></p>
  <h3>投稿日時</h3>
  <p><%= @tweet.created_at%></p>
    <% if user_signed_in? %>
        <% if current_user.already_liked?(@tweet) %>
          <%= button_to tweet_like_path(@tweet), method: :delete do %>
            <i class="fa-solid fa-heart"></i>
            <p>いいねを取り消す <%= @tweet.likes.count %> </p>
          <% end %>
        <% else %>
          <%= button_to tweet_likes_path(@tweet), method: :post do %>
            <i class="fa-solid fa-heart"></i>
            <p>いいね <%= @tweet.likes.count %> </p>
          <% end %>
        <% end %>
      <% else %>
        <i class="fa-solid fa-heart"></i>
        いいねの数 = <%= @tweet.likes.count %>
      <% end %>

    <p><%= link_to "編集する", edit_tweet_path(@tweet.id) %></p>
</div>

<h2>いいねしたユーザー</h2>
<% @tweet.liked_users.each do |user| %>
  <li><%= user.email %></li>
<% end %>
<%= link_to "Tweet一覧に戻る", tweets_path %>
